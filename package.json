{
  "name": "dictation-repair-book",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:site": "vite --config vite.site.config.ts --host 127.0.0.1",
    "build:app": "vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "build": "npm run build:app && npm run build:site",
    "test": "npm run test:unit && npm run test:installer-contract && npm run test:native && npm run test:e2e",
    "test:unit": "vitest run",
    "test:installer-contract": "node tests/installers.mjs",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "test:e2e": "node scripts/run-e2e.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview:site": "vite preview --config vite.site.config.ts --host 127.0.0.1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^22.17.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
